<odoo>
    <record id="view_employee_form_inherit_new" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.hr.employee.new</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='identification_id']" position="after">
                <field name="cccd_issue_date"/>
                <field name="cccd_issue_place"/>
                <div class="o_address_format">
                    <field name="private_permanent_street"
                           placeholder="Street..."
                           class="o_address_street" invisible="1"/>

                    <field name="private_permanent_street2"
                           placeholder="Street 2..."
                           class="o_address_street" invisible="1"/>

                    <field name="private_permanent_city"
                           placeholder="City"
                           class="o_address_city" invisible="1"/>

                    <field name="private_permanent_state_id"
                           class="o_address_state"
                           placeholder="State"
                           options="{'no_open': True, 'no_create': True}"
                           context="{'default_country_id': private_permanent_country_id}" invisible="1"/>

                    <field name="private_permanent_country_id"
                           placeholder="Country"
                           class="o_address_country"
                           options='{"no_open": true, "no_create": true}' invisible="1"/>
                </div>
            </xpath>

        </field>
    </record>
</odoo>