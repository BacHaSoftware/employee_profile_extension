<odoo>
    <record id="bhs_res_users_view_form_profile_private_information_inherit" model="ir.ui.view">
        <field name="name">bhs.res.users.view.form.profile.private.information</field>
        <field name="model">res.users</field>
        <!-- Odoo 19: hr.res_users_view_form_profile doesn't exist, using hr.res_users_view_form_preferences instead -->
        <field name="inherit_id" ref="hr.res_users_view_form_preferences"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='private_phone']" position="after">
                <div class="o_address_format">
                    <field name="private_permanent_street" placeholder="Street..." class="o_address_street" invisible="1"/>
                    <field name="private_permanent_street2" placeholder="Street 2..." class="o_address_street" invisible="1"/>
                    <field name="private_permanent_city" placeholder="City" class="o_address_city" invisible="1"/>
                    <field name="private_permanent_state_id" class="o_address_state" placeholder="State" invisible="1" options="{'no_open': True, 'no_create': True}" context="{'default_country_id': private_country_id}"/>
                    <field name="private_permanent_country_id" placeholder="Country" class="o_address_country" invisible="1" options='{"no_open": True, "no_create": True}'/>
                </div>
            </xpath>
            <xpath expr="//field[@name='emergency_phone']" position="after">
                <group string="Private information" colspan="2">
                    <field name="birthday" readonly="0"/>
                    <field name="ssnid" readonly="0" invisible="1"/>
                    <field name="identification_id" readonly="0"/>
                    <field name="cccd_issue_date"/>
                    <field name="cccd_issue_place"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>